<Window x:Class="AFMediaBar.Views.Windows.TrackChangeNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Loc.Panel.Notification.WindowTitle}"
        MaxWidth="520" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="{DynamicResource AppTextFontFamily}">
    <Grid x:Name="AnimatedRoot" Margin="8" Opacity="0" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="EntryTransform" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ArtworkColumn" Width="72" />
            <ColumnDefinition x:Name="ArtworkGapColumn" Width="14" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="ArtworkBorder" Width="72" Height="72" CornerRadius="4" ClipToBounds="True"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.18" />
            </Border.Effect>
            <Grid>
                <ui:SymbolIcon x:Name="ArtworkPlaceholder" Symbol="MusicNote220" FontSize="30" />
            </Grid>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="300">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Foreground="#202020"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.12" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="ArtistText" Margin="0,4,0,0" FontSize="15" Foreground="#666666"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.12" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
